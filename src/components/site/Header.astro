---
import { primaryNav, sections } from '../../data/site';
import Brand from './Brand.astro';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && (href === '/' ? path === '/' : path.startsWith(href));
const lines = primaryNav.filter((n) => n.label !== 'Contact');
const contact = primaryNav.find((n) => n.label === 'Contact');
---

<header class="hdr" data-hdr>
  <Brand />

  <nav class="hdr__nav" aria-label="Primary">
    <span class="hdr__lines">
      {
        lines.map((item) => (
          <a
            class="hdr__link hdr__link--line"
            href={item.href}
            aria-label={`${item.label}: ${item.note}`}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </span>
    {
      contact && (
        <a class="hdr__link hdr__link--cta" href={contact.href}>
          {contact.label}
        </a>
      )
    }
  </nav>

  <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <span>Menu</span>
    <span class="hdr__toggle-bars" aria-hidden="true"></span>
  </button>
</header>

<div class="menu theme-dark" id="site-menu" data-menu inert>
  <nav class="menu__primary" aria-label="Primary">
    {
      primaryNav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
          <span>{item.note}</span>
        </a>
      ))
    }
  </nav>
  {
    home && (
      <nav class="menu__sections" aria-label="On this page">
        {sections.map((s) => (
          <a href={`#${s.id}`}>
            <span>{s.n}</span>
            {s.label}
          </a>
        ))}
      </nav>
    )
  }
</div>

{
  home && (
    <nav class="rail" aria-label="On this page" data-rail>
      {sections.map((s) => (
        <a href={`#${s.id}`} aria-label={`${s.n} ${s.label}`}>
          <span aria-hidden="true">{s.n} · {s.label}</span>
        </a>
      ))}
    </nav>
  )
}
