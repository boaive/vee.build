---
import { primaryNav, sections, site } from '../../data/site';
const year = new Date().getFullYear();
const { email, phone, address, legalName } = site.contact;
const hasContact = email || phone || address;
---

<footer class="ftr theme-dark" data-theme="dark">
  <div class="wrap">
    <div class="ftr__top">
      <div>
        <a class="brand" href="/" aria-label={`${site.name} — home`}>
          <svg class="brand__mark" viewBox="0 0 34.5 12" aria-hidden="true">
            <rect x="0.75" y="0.75" width="21" height="10.5"></rect>
            <rect x="23.25" y="0.75" width="10.5" height="10.5"></rect>
          </svg>
          <span class="brand__word">VEE<i>.</i>BUILD</span>
        </a>
        <p class="ftr__statement">
          Two standardised precast shells, 6 m × 3 m × 3 m and 3 m × 3 m × 3 m. One system, configured into many
          buildings.
        </p>
      </div>

      <div class="ftr__cols">
        <div class="ftr__col">
          <h2 class="t-label">Products</h2>
          {primaryNav.slice(0, 4).map((n) => <a href={n.href}>{n.label}</a>)}
        </div>
        <div class="ftr__col">
          <h2 class="t-label">The system</h2>
          {sections.slice(1, 8).map((s) => <a href={`/#${s.id}`}>{s.label}</a>)}
        </div>
        <div class="ftr__col">
          <h2 class="t-label">Contact</h2>
          <a href="/#contact">Start an enquiry</a>
          <a href="/partnership/#enquire">Partner with us</a>
          {
            hasContact && (
              <>
                {email && <a href={`mailto:${email}`}>{email}</a>}
                {phone && <a href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a>}
                {address && <p>{address}</p>}
              </>
            )
          }
        </div>
      </div>
    </div>

    <div class="ftr__base t-label">
      <span>© {year} {legalName ?? site.name}</span>
      <span>Modular · Capsule · Prefab</span>
    </div>
  </div>
</footer>
