---
import { Image } from 'astro:assets';
import hemisphereOne from '../../assets/brand/hemisphere-one.png';
import { bandNav, primaryNav, sections, site } from '../../data/site';
import Brand from './Brand.astro';
const year = new Date().getFullYear();
const { email, phone, address, legalName } = site.contact;
const hasContact = email || phone || address;
const products = primaryNav.filter((n) => n.label !== 'Contact');
---

<footer class="ftr theme-dark" data-theme="dark">
  <div class="wrap">
    <div class="ftr__top">
      <div>
        <Brand class="brand--lg" />
        <p class="ftr__statement">One system. Many buildings. Modular houses, capsule homes and prefab buildings, made in a factory and set on your site.</p>
      </div>

      <div class="ftr__cols">
        <div class="ftr__col">
          <h2 class="t-label">Products</h2>
          {
            products.map((n) => (
              <a href={n.href}>
                <span class="ftr__code">{n.label}</span>
                {n.note}
              </a>
            ))
          }
        </div>
        <div class="ftr__col">
          <h2 class="t-label">The system</h2>
          {sections.slice(1, -1).map((s) => <a href={`/#${s.id}`}>{s.label}</a>)}
        </div>
        <div class="ftr__col">
          <h2 class="t-label">Contact</h2>
          <a href="/#contact">Start an enquiry</a>
          <a href="/partnership/#enquire">Partner with VEE</a>
          {
            hasContact && (
              <>
                {email && <a href={`mailto:${email}`}>{email}</a>}
                {phone && <a href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a>}
                {address && <p>{address}</p>}
              </>
            )
          }
        </div>
      </div>
    </div>

    <div class="ftr__base t-label">
      <span>© {year} {legalName ?? site.name}</span>
      <span>Modular · Capsule · Prefab</span>
    </div>
  </div>

  {/* The bottom band (client, 2026-10-09): what is not in the top menu, and who the site is powered by. On paper, where the supplied logo reads as drawn. */}
  <div class="band theme-light">
    <div class="wrap band__in">
      <nav class="band__nav" aria-label="More">
        {bandNav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <p class="band__by">
        <span class="t-label">Powered by</span>
        <Image src={hemisphereOne} alt={site.poweredBy} height={30} densities={[1, 2, 3]} loading="lazy" />
      </p>
    </div>
  </div>
</footer>
