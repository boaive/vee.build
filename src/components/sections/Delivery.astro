---
import DeliveryRoute from './DeliveryRoute.tsx';
---

<section class="section delivery theme-dark" id="delivery" data-theme="dark" data-chapter="factory" aria-labelledby="delivery-heading">
  <div class="wrap">
    <header class="intro">
      <p class="eyebrow"><b>06</b> Delivery</p>
      <h2 class="t-h2" id="delivery-heading" data-reveal>On its way to your site.</h2>
      <p class="t-lead" data-reveal style="--i:1">
        Finished shells leave the yard on a truck, ready to be lifted into place when they arrive.
      </p>
    </header>
    <DeliveryRoute client:visible={{ rootMargin: '200px' }} />
  </div>
</section>
