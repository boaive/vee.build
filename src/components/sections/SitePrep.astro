---
/**
 * Section 6, part 3: site preparation, said rather than animated. The three
 * components are the brief's; how they relate is illustrative (notes C2).
 */
const parts = [
  { id: 'plug', name: 'Plug footing', text: 'Precast footing, set on the prepared ground.' },
  { id: 'plinth', name: 'L plinth', text: 'Precast plinth sections, laid ahead of the shells.' },
  { id: 'jack', name: 'Jack pier', text: 'Height is set on the jack thread, so every shell sits level.' },
];
---

<section class="section prep theme-light" id="site" data-theme="light" data-chapter="delivery" aria-labelledby="site-heading">
  <div class="wrap">
    <header class="intro">
      <p class="eyebrow"><b>08</b> Site preparation</p>
      <h2 class="t-h2" id="site-heading" data-reveal>Ready before the shells arrive.</h2>
      <p class="t-lead" data-reveal style="--i:1">
        Off-site construction with absolute minimum site impact. Three precast components set the building on the
        ground.
      </p>
    </header>

    <ol class="prep__grid">
      {
        parts.map((p, i) => (
          <li class="prep__card" data-reveal style={`--i:${i}`}>
            <span class="t-label prep__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="prep__fig" aria-hidden="true">
              {p.id === 'plug' && (
                <svg viewBox="0 0 200 150">
                  <path class="ln" d="M60 92 L100 112 L140 92 L100 72 Z" />
                  <path class="ln" d="M44 100 L100 128 L156 100 M44 100 L60 92 M156 100 L140 92 M100 128 L100 112" />
                  <path class="ln" d="M70 60 L100 75 L130 60 L100 45 Z M70 60 L70 70 M130 60 L130 70 M100 75 L100 86" />
                  <path class="ln mute" d="M70 70 L60 92 M130 70 L140 92" />
                  <path class="dim" d="M168 62 L168 112 M163 62 L173 62 M163 112 L173 112" />
                </svg>
              )}
              {p.id === 'plinth' && (
                <svg viewBox="0 0 200 150">
                  <path class="ln" d="M30 96 L120 51 L150 66 L60 111 Z" />
                  <path class="ln" d="M60 111 L60 121 L150 76 L150 66" />
                  <path class="ln" d="M30 96 L30 106 L60 121" />
                  <path class="ln" d="M120 51 L120 26 L130 21 L130 46 M30 96 L30 71 L40 66 L40 91 M30 71 L120 26 M40 66 L130 21" />
                  <path class="dim" d="M40 130 L150 75" />
                </svg>
              )}
              {p.id === 'jack' && (
                <svg viewBox="0 0 200 150">
                  <path class="ln" d="M70 118 L100 133 L130 118 L100 103 Z" />
                  <path class="ln" d="M88 112 L88 96 M112 112 L112 96 M88 96 Q100 102 112 96" />
                  <path class="ln" d="M96 96 L96 40 M104 96 L104 40" />
                  <path class="ln mute" d="M96 88 L104 86 M96 80 L104 78 M96 72 L104 70 M96 64 L104 62 M96 56 L104 54 M96 48 L104 46" />
                  <path class="ln" d="M76 40 L100 52 L124 40 L100 28 Z" />
                  <path class="dim" d="M150 40 L150 112 M145 40 L155 40 M145 112 L155 112 M150 52 L144 60 M150 52 L156 60 M150 100 L144 92 M150 100 L156 92" />
                </svg>
              )}
            </div>
            <h3 class="prep__name">{p.name}</h3>
            <p class="prep__text">{p.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="t-label prep__note mute">Arrangement shown is illustrative.</p>
  </div>
</section>
