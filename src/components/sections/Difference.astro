---
import { differences } from '../../data/difference';

/*
 * The six points, all on show: a ledger of six cells (number, word, claim,
 * detail), then the comparisons the brief draws, each set against what it
 * replaces. Document flow, nothing pinned. Each part comes in as it is
 * scrolled to; a point and its comparison light up together under the
 * pointer. Without script, with reduced motion or with ?still it is the
 * same page standing still.
 */
const pad = (i: number) => String(i + 1).padStart(2, '0');
const compared = differences.filter((d) => d.other);
---

<section class="diff theme-light" id="difference" data-theme="light" data-chapter="difference" aria-labelledby="difference-heading" data-diff>
  <div class="wrap">
    <header class="diff__head">
      <p class="eyebrow" data-rv><b>04</b> How we are different</p>
      <h2 class="diff__title" id="difference-heading">
        <span class="diff__ln" data-rv><span>How are we</span></span>
        <span class="diff__ln" data-rv style="--i:1"><span>different?</span></span>
      </h2>
      <p class="diff__lead" data-rv style="--i:2">
        Six points separate a VEE.BUILD building from brick-and-mortar construction and from lightweight prefab.
      </p>
    </header>

    <ol class="diff__grid">
      {
        differences.map((d, i) => (
          <li class="diff__cell" data-rv data-id={d.id} style={`--i:${i % 3}`}>
            <p class="t-label diff__n" aria-hidden="true">
              {pad(i)}
            </p>
            <h3 class="diff__word">{d.word}</h3>
            <p class="diff__claim">{d.claim}</p>
            <p class="diff__detail">{d.detail}</p>
            {d.marks && (
              <ul class="diff__marks" aria-label="Referenced bodies">
                {d.marks.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <div class="diff__vs">
      <div class="diff__vs-head" data-rv aria-hidden="true">
        <span></span>
        <p class="t-label">VEE.BUILD</p>
        <p class="t-label">Others</p>
      </div>
      <ul class="diff__rows">
        {
          compared.map((d) => (
            <li class="diff__row" data-rv data-id={d.id}>
              <p class="t-label diff__tag">{d.word}</p>
              <p class="diff__ours">{d.claim}</p>
              <p class="diff__other">
                <span class="sr-only">Instead of: </span>
                <span class="diff__struck">{d.other}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-diff]');
  if (root) {
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches || new URLSearchParams(location.search).has('still');
    // Each part comes in once, when it is scrolled to. Nothing is hidden unless this runs.
    if (!calm && 'IntersectionObserver' in window) {
      root.classList.add('is-armed');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
      );
      root.querySelectorAll('[data-rv]').forEach((el) => io.observe(el));
    }
    // A point and its comparison light up together.
    const linked = [...root.querySelectorAll<HTMLElement>('[data-id]')];
    const hot = (id: string | undefined, on: boolean) => linked.forEach((el) => el.dataset.id === id && el.classList.toggle('is-hot', on));
    linked.forEach((el) => {
      el.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && hot(el.dataset.id, true));
      el.addEventListener('pointerleave', () => hot(el.dataset.id, false));
    });
  }
</script>
