---
import Base from '../layouts/Base.astro';
import PodHero from '../components/sections/PodHero.tsx';
import PodLayers from '../components/sections/PodLayers.tsx';
import PodPlans from '../components/sections/PodPlans.tsx';
import EnquiryForm from '../components/forms/EnquiryForm.tsx';
import { podLengthName, podLengths } from '../data/pod';
import { site } from '../data/site';

/*
 * POD (developer, 2026-11-09): the pod alone on the studio floor, then its
 * land, its length chosen all the while (PodHero, as the MOD page opens);
 * the pod taken apart and built again, layer by layer (PodLayers); its
 * plans, length by length (PodPlans); the form last.
 */
const names = podLengths.map(podLengthName);
---

<Base
  title="Capsule home"
  description={`${site.short} capsule homes: a galvanised steel frame clad in TRC concrete panels, ${names.slice(0, -1).join(', ')} or ${names[names.length - 1]} long.`}
>
  <PodHero client:load />
  <PodLayers client:idle />
  <PodPlans client:visible />

  <section class="section theme-dark" data-theme="dark" id="register" aria-labelledby="register-heading">
    <div class="wrap contact__grid">
      <div>
        <h2 class="t-h2" id="register-heading" data-reveal>Enquire about a capsule home.</h2>
        <p class="t-lead contact__lead mute" data-reveal style="--i:1">
          Tell us which length and layout you are considering, and where it would go.
        </p>
      </div>
      <EnquiryForm client:visible variant="contact" preset="Capsule Pod" />
    </div>
  </section>
</Base>
