---
import Base from '../layouts/Base.astro';
import { story } from '../data/site';
---

<Base title="Page not found">
  <section class="wrap notfound" data-theme="light">
    <p class="t-label mute">404</p>
    <h1 class="t-display">This page could not be found.</h1>
    <p class="t-lead">The address may have changed. The whole system is explained on the MOD page, and the enquiry form is on the home page.</p>
    <p class="notfound__actions">
      <a class="btn" href="/">Home</a>
      <a class="btn btn--ghost" href={story}>The modular house</a>
    </p>
  </section>
</Base>
