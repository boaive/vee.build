---
import Base from '../layouts/Base.astro';
import ModHero from '../components/sections/ModHero.tsx';
import HowItWorks from '../components/sections/HowItWorks.tsx';
import Components from '../components/sections/Components.tsx';
import Difference from '../components/sections/Difference.astro';
import BuildSection from '../components/sections/BuildSection.astro';
import YourHouse from '../components/sections/YourHouse.tsx';
import CatalogueSection from '../components/sections/CatalogueSection.astro';
import FactoryTour from '../components/sections/FactoryTour.tsx';
import Transit from '../components/sections/Transit.tsx';
import Installation from '../components/sections/Installation.tsx';
import Arrival from '../components/sections/Arrival.astro';
import Gallery from '../components/sections/Gallery.astro';
import Contact from '../components/sections/Contact.astro';
import { kinds } from '../data/narrative';
import { numberOf, shown, site } from '../data/site';
import { footprints, shells } from '../data/system';

/*
 * MOD (developer, 2026-11-07): the modular house, then its land, then the
 * whole story of the system that the home page told until that day, in the
 * same order and numbered from here (data/site.ts, `sections`), and the
 * enquiry form last.
 *
 * The films below the opening hydrate once the page is idle after load. That
 * is only their captions and scroll wiring (a few milliseconds each): every
 * 3D scene still mounts when its section nears the viewport. Hydrating on
 * approach instead put that work in the middle of a scroll.
 */
const mod = kinds.find((k) => k.id === 'mod')!;
const { A, B } = shells;
const sizes = footprints.map((f) => f.sqft);
---

<Base
  title="Modular house"
  description={`${site.short} modular houses: ${mod.line.toLowerCase()} Two standard shells, ${A.label} and ${B.label}, in footprints from ${sizes[0]} to ${sizes[sizes.length - 1]} sq.ft.`}
  chapters
  boot="modular"
>
  <ModHero client:load />
  <HowItWorks client:idle />
  <Components client:idle />
  <Difference />
  <BuildSection />
  <YourHouse client:idle />
  <FactoryTour client:idle />
  <Transit client:idle />
  <Installation client:idle />
  <Arrival />
  {/* Built, not shown for now (client, 2026-10-10): data/site.ts, `shown`. */}
  {shown.catalogue && <CatalogueSection />}
  <Gallery />
  <Contact index={numberOf('contact')} preset="Modular Home" lead="Tell us where it will stand and the size you have in mind." />
</Base>
