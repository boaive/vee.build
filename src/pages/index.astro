---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.tsx';
import Lines from '../components/sections/Lines.astro';
import Contact from '../components/sections/Contact.astro';
import { sections, site, story } from '../data/site';

/*
 * Home since 2026-11-07 (developer: "since this is the home screen, we
 * don't have to show everything in here ... show then possibilities what can
 * be done, like mod, pod and fab. remove every other things ... below that
 * the footer with call to action as it is"): the banners, the three lines,
 * the enquiry form. Everything else moved to the MOD page (data/site.ts,
 * `story`).
 *
 * A link to one of those chapters made before the move (/#factory, a shared
 * configuration /?build=…#configure) is sent on to the MOD page, before
 * anything is drawn.
 */
const moved = sections.filter((s) => s.id !== 'contact').map((s) => s.id);
const forward = `(function () {
  var moved = ${JSON.stringify(moved)};
  var id = location.hash.slice(1);
  if (new URLSearchParams(location.search).has('build') || moved.indexOf(id) >= 0) location.replace(${JSON.stringify(story)} + location.search + location.hash);
})();`;
---

<Base title={`${site.name} — Modular precast construction system`} boot="overview">
  <script is:inline set:html={forward} slot="head" />
  <Hero client:load />
  <Lines />
  <Contact />
</Base>
