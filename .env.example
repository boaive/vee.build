# Cloudflare Turnstile's site key (public). The enquiry form and the admin
# panel's sign-in use it; its secret key is set on the Worker (admin/README.md).
# For local development, Cloudflare's test key, which always passes:
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional. Where the enquiry form posts. Empty: the site's own API,
# /api/enquiries, served by the same Cloudflare Worker as the site.
PUBLIC_ENQUIRY_ENDPOINT=
