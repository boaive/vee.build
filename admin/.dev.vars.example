# Copy to .dev.vars for `npm run dev` (wrangler dev). Never commit .dev.vars.
# Cloudflare's published Turnstile test secret: every token passes.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_SALT=local-development-only
# The Vite (panel) and Astro (site) dev servers call the API from these origins.
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:4321,http://127.0.0.1:5174,http://127.0.0.1:4321
