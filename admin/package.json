{
  "name": "vee-build-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The admin panel and the backend of vee.build: one Cloudflare Worker serves the site, /admin and /api.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:panel": "vite --config panel/vite.config.ts",
    "build": "vite build --config panel/vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply vee --local",
    "db:migrate:remote": "wrangler d1 migrations apply vee --remote",
    "password:local": "node scripts/set-password.mjs --local",
    "password:remote": "node scripts/set-password.mjs --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p api/tsconfig.json && tsc -p panel/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.9.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  }
}
